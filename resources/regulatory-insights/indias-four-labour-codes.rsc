1:["$","$Ld",null,{"children":[["$","$Le",null,{"label":"Regulatory insights · India","title":"India’s four labour codes.","description":"A starting point for reviewing workforce records, payroll processes and compliance responsibilities."}],["$","div",null,{"className":"container reading-layout section","children":[["$","aside",null,{"className":"contents-nav","children":[["$","span",null,{"children":"IN THIS GUIDE"}],["$","a",null,{"href":"#overview","children":"The four codes"}],["$","a",null,{"href":"#review","children":"Operational review"}],["$","a",null,{"href":"#source","children":"Official source"}],["$","$Lf",null,{"href":"/resources/notifications","children":"More regulatory sources"}]]}],["$","article",null,{"className":"reading-body","children":[["$","p",null,{"className":"review-date","children":["Reviewed: ","10 September 2026"," · India · General information"]}],["$","section",null,{"id":"overview","children":[["$","h2",null,{"children":"What changed?"}],["$","p",null,{"children":"The Government of India announced that the four labour codes took effect on 21 November 2025, consolidating 29 central labour laws. The announcement also describes transitional arrangements. Check the latest rules and notifications for your specific establishment."}],["$","div",null,{"className":"code-grid","children":[["$","div","Code on Wages, 2019",{"children":[["$","h3",null,{"children":"Code on Wages, 2019"}],["$","p",null,{"children":"Wages, payment practices and related payroll records."}]]}],["$","div","Industrial Relations Code, 2020",{"children":[["$","h3",null,{"children":"Industrial Relations Code, 2020"}],["$","p",null,{"children":"Employment relations and related workplace procedures."}]]}],["$","div","Code on Social Security, 2020",{"children":[["$","h3",null,{"children":"Code on Social Security, 2020"}],["$","p",null,{"children":"Social security arrangements and associated workforce records."}]]}],["$","div","Occupational Safety, Health and Working Conditions Code, 2020",{"children":[["$","h3",null,{"children":"Occupational Safety, Health and Working Conditions Code, 2020"}],["$","p",null,{"children":"Safety, working conditions and establishment responsibilities."}]]}]]}]]}],["$","section",null,{"id":"review","children":[["$","h2",null,{"children":"A practical review for HR and Finance"}],["$","p",null,{"children":"Use these questions to organise an assessment, rather than as a complete legal compliance checklist."}],["$","ol",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Map the workforce."}]," Identify employing entities, establishments, states, employee categories and contractor arrangements."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Review payroll inputs."}]," Bring salary components, attendance, overtime and settlement processes into the review."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Check supporting records."}]," Locate appointment documents, registers, contribution records and contractor evidence."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Assign decisions and actions."}]," Record which questions need legal interpretation, who owns each action and what evidence will close it."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Communicate agreed changes."}]," Align HR, Finance, site teams and contractors before implementing revised processes."]}]]}],["$","p",null,{"children":"Rates, eligibility, thresholds and deadlines depend on applicable provisions and notifications. Obtain advice for your circumstances before changing payroll or employment policies."}]]}],["$","section",null,{"id":"source","children":[["$","h2",null,{"children":"Official source"}],["$","p",null,{"children":["$","a",null,{"href":"https://www.pib.gov.in/PressReleasePage.aspx?PRID=2194018","children":"Ministry of Labour & Employment announcement, published by PIB on 25 November 2025"}]}],["$","p",null,{"children":["This guide was reviewed on ","10 September 2026","; it is not a live update service."]}],["$","$Lf",null,{"className":"button","href":"/contact?service=Compliance%20Audit","children":["Discuss a compliance review ","$L10"]}]]}]]}]]}]]}]
