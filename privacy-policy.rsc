1:["$","$Ld",null,{"children":[["$","$Le",null,{"label":"Privacy Policy","title":"Privacy Policy","description":"How information is handled on the OrdinHR website."}],["$","div",null,{"className":"container reading-layout section","children":[["$","aside",null,{"className":"contents-nav","children":[["$","span",null,{"children":"ON THIS PAGE"}],[["$","a","scope",{"href":"#scope","children":"1. Scope of this notice"}],["$","a","form",{"href":"#form","children":"2. Information you enter"}],["$","a","hosting",{"href":"#hosting","children":"3. Website hosting and technical information"}],["$","a","sharing",{"href":"#sharing","children":"4. Sharing and external links"}],["$","a","control",{"href":"#control","children":"5. Your choices"}],["$","a","changes",{"href":"#changes","children":"6. Updates"}]]]}],["$","article",null,{"className":"reading-body","children":[["$","p",null,{"className":"review-date","children":["Last reviewed: ","10 September 2026"]}],[["$","section","scope",{"id":"scope","children":[["$","h2",null,{"children":"1. Scope of this notice"}],[["$","p","This notice covers visitors to this website and the enquiry preparation form. It does not describe the processing of employee or payroll records under a client engagement. Any such engagement needs its own agreed data-handling arrangements.",{"children":"This notice covers visitors to this website and the enquiry preparation form. It does not describe the processing of employee or payroll records under a client engagement. Any such engagement needs its own agreed data-handling arrangements."}]],"$undefined"]}],["$","section","form",{"id":"form","children":[["$","h2",null,{"children":"2. Information you enter"}],[["$","p","The enquiry form asks for your name, company, phone, email, employee count, operating locations, required service and an optional message. It opens an email draft to myselfarihantsaini@gmail.com in your chosen email app. You must send the email to complete your enquiry. The website does not automatically submit the form or store its entries in an application database. You can also download a text copy.",{"children":"The enquiry form asks for your name, company, phone, email, employee count, operating locations, required service and an optional message. It opens an email draft to myselfarihantsaini@gmail.com in your chosen email app. You must send the email to complete your enquiry. The website does not automatically submit the form or store its entries in an application database. You can also download a text copy."}],["$","p","Form values are held in the current page session. A downloaded enquiry remains on your device until you remove it. Do not enter employee identity documents, bank details, medical information or individual salary records in this public form.",{"children":"Form values are held in the current page session. A downloaded enquiry remains on your device until you remove it. Do not enter employee identity documents, bank details, medical information or individual salary records in this public form."}]],"$undefined"]}],["$","section","hosting",{"id":"hosting","children":[["$","h2",null,{"children":"3. Website hosting and technical information"}],[["$","p","The public website at shambhavaa.com/payroll is hosted through GitHub Pages. When a page is requested, the hosting provider receives technical information such as the IP address, requested URL and browser information. Provider processing and retention are governed by their own policies.",{"children":"The public website at shambhavaa.com/payroll is hosted through GitHub Pages. When a page is requested, the hosting provider receives technical information such as the IP address, requested URL and browser information. Provider processing and retention are governed by their own policies."}],"$Lf"],"$undefined"]}],"$L10","$L11","$L12"],"$L13"]}]]}]]}]
f:["$","p","OrdinHR has not added advertising trackers or an analytics integration to this website. Hosting and platform services may use their own operational or security technologies.",{"children":"OrdinHR has not added advertising trackers or an analytics integration to this website. Hosting and platform services may use their own operational or security technologies."}]
10:["$","section","sharing",{"id":"sharing","children":[["$","h2",null,{"children":"4. Sharing and external links"}],[["$","p","The form passes the draft to your chosen email app. When you send it, OrdinHR receives the details you included; your email provider also processes the message under its own privacy practices. If you share a downloaded copy, the recipient receives its contents. Resource links take you to external websites with their own privacy practices.",{"children":"The form passes the draft to your chosen email app. When you send it, OrdinHR receives the details you included; your email provider also processes the message under its own privacy practices. If you share a downloaded copy, the recipient receives its contents. Resource links take you to external websites with their own privacy practices."}],["$","p","Service-related processing, authorised recipients, security measures, retention and any cross-border transfers must be documented separately before client records are exchanged.",{"children":"Service-related processing, authorised recipients, security measures, retention and any cross-border transfers must be documented separately before client records are exchanged."}]],"$undefined"]}]
11:["$","section","control",{"id":"control","children":[["$","h2",null,{"children":"5. Your choices"}],[["$","p","You can use the website without completing the form, clear the fields, leave the page or delete your downloaded file. Requests concerning a hosting provider’s records should use that provider’s privacy channels.",{"children":"You can use the website without completing the form, clear the fields, leave the page or delete your downloaded file. Requests concerning a hosting provider’s records should use that provider’s privacy channels."}],["$","p","For privacy questions, contact H. Arihant on +91 90579 18251 or email myselfarihantsaini@gmail.com. For an existing client engagement, you may also use your agreed business contact.",{"children":"For privacy questions, contact H. Arihant on +91 90579 18251 or email myselfarihantsaini@gmail.com. For an existing client engagement, you may also use your agreed business contact."}]],"$undefined"]}]
12:["$","section","changes",{"id":"changes","children":[["$","h2",null,{"children":"6. Updates"}],[["$","p","This notice should be updated when enquiry delivery, analytics, account access or other data-processing features are introduced. The review date above identifies this version.",{"children":"This notice should be updated when enquiry delivery, analytics, account access or other data-processing features are introduced. The review date above identifies this version."}]],"$undefined"]}]
13:["$","section",null,{"children":[["$","h2",null,{"children":"Hosting provider policies"}],["$","p",null,{"children":[["$","a",null,{"href":"https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement","children":"GitHub Privacy Statement"}]," ","·"," ",["$","a",null,{"href":"https://openai.com/policies/privacy-policy/","children":"OpenAI Privacy Policy"}]]}]]}]
